{
  "name": "Folly",
  "version": "2018.10.22.00",
  "license": "none",
  "homepage": "https://github.com/tuya",
  "summary": "An open-source C++ library developed and used at Facebook.",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "2018.10.22.00"
  },
  "module_name": "folly",
  "dependencies": {
    "boost-for-react-native": [],
    "DoubleConversion": [],
    "glog": []
  },
  "compiler_flags": "-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1",
  "preserve_paths": [
    "folly/*.h",
    "folly/container/*.h",
    "folly/container/detail/*.h",
    "folly/detail/*.h",
    "folly/functional/*.h",
    "folly/hash/*.h",
    "folly/lang/*.h",
    "folly/memory/*.h",
    "folly/memory/detail/*.h",
    "folly/portability/*.h"
  ],
  "libraries": "stdc++",
  "pod_target_xcconfig": {
    "USE_HEADERMAP": "NO",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++14",
    "HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)\" \"$(PODS_ROOT)/boost-for-react-native\" \"$(PODS_ROOT)/DoubleConversion\""
  },
  "platforms": {
    "ios": "9.0"
  },
  "vendored_frameworks": [
    "Frameworks/Folly/folly.xcframework"
  ],
  "cocoapods_version": ">= 1.10"
}