{
  "name": "ThingMotionDetectSDK",
  "version": "1.0.5",
  "summary": "ThingMotionDetectSDK framework for motion detection in video streams.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "1.0.5"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": "ThingMotionDetectSDK/**/Android/**/*.*",
  "dependencies": {
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingMotionDetectSDK ",
    "ENABLE_BITCODE": "NO",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "vendored_frameworks": [
    "Frameworks/ThingMotionDetectSDK/ThingMotionDetectSDK.xcframework"
  ],
  "source_files": [
    "Frameworks/ThingMotionDetectSDK/ThingMotionDetectSDK.xcframework/**/*.h"
  ]
}