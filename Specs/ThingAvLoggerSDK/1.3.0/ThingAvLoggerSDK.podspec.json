{
  "name": "ThingAvLoggerSDK",
  "version": "1.3.0",
  "summary": "ThingAvLoggerSDK framework.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "1.3.0"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": [
    "ThingAvLoggerSDK/**/Android/**/*.*",
    "ThingAvLoggerSDK/include/**/*.*"
  ],
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAvLoggerSDK/Utils $(PODS_TARGET_SRCROOT)/ThingAvLoggerSDK/CAPI $(PODS_TARGET_SRCROOT)/ThingAvLoggerSDK/av-logger $(PODS_TARGET_SRCROOT)/ThingAvLoggerSDK/include/sdplog",
    "ENABLE_BITCODE": "NO",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "vendored_frameworks": [
    "Frameworks/ThingAvLoggerSDK/ThingAvLoggerSDK.xcframework"
  ],
  "source_files": [
    "Frameworks/ThingAvLoggerSDK/ThingAvLoggerSDK.xcframework/**/*.h"
  ]
}