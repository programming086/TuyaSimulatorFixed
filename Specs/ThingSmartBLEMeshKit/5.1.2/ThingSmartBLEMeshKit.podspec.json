{
  "name": "ThingSmartBLEMeshKit",
  "version": "5.1.2",
  "summary": "A short description of ThingSmartBLEMeshKit.",
  "homepage": "https://thing.com",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Tuya": "developer@tuya.com"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "5.1.2"
  },
  "static_framework": true,
  "platforms": {
    "ios": "9.0"
  },
  "prefix_header_contents": [
    "#ifdef __OBJC__",
    "#import <YYModel/YYModel.h>",
    "#import \"ThingSmartBLEMeshKit.h\"",
    "#import \"ThingMeshNotificationUtils.h\"",
    "#import \"ThingMeshApiConf.h\"",
    "#import \"ThingMeshPrivateDef.h\"",
    "#import <ThingBluetooth/ThingBluetooth.h>",
    "#import \"ThingSmartSIGMeshConstants.h\"",
    "#import \"NSData+ThingSDKHex.h\"",
    "#endif"
  ],
  "pod_target_xcconfig": {
    "TUYA_PRIVACY_USAGE_DESCRIPTION": "NSBluetoothAlwaysUsageDescription NSBluetoothPeripheralUsageDescription",
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES",
    "DEFINES_MODULE": "YES"
  },
  "frameworks": [
    "Foundation",
    "CoreBluetooth"
  ],
  "dependencies": {
    "ThingSmartDeviceCoreKit": [
      "~> 5.0"
    ],
    "ThingSmartActivatorCoreKit": [
      "~> 5.0"
    ],
    "ThingBluetooth": [
      "~> 5.0",
      "< 10.0"
    ],
    "ThingSmartBaseKit": [
      "~> 5.0"
    ]
  },
  "user_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "vendored_frameworks": [
    "Frameworks/ThingSmartBLEMeshKit/ThingSmartBLEMeshKit.xcframework"
  ],
  "source_files": [
    "Frameworks/ThingSmartBLEMeshKit/ThingSmartBLEMeshKit.xcframework/**/*.h"
  ]
