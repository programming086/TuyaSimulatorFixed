{
  "name": "ThingFFmpegWrapper",
  "version": "4.4.2.10",
  "summary": "tuya ffmpeg wrapper .",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "4.4.2.10"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": [
    "ThingFFmpegWrapper/libs/Android/*",
    "ThingFFmpegWrapper/Platforms/Android/*"
  ],
  "ios": {},
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "OTHER_LDFLAGS": "-read_only_relocs suppress",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingFFmpegWrapper $(PODS_TARGET_SRCROOT)/ThingFFmpegWrapper/Platforms/iOS  $(PODS_TARGET_SRCROOT)/ThingFFmpegWrapper/include/ffmpeg ",
    "ENABLE_BITCODE": "NO",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "vendored_frameworks": [
    "Frameworks/ThingFFmpegWrapper/ThingFFmpegWrapper.xcframework"
  ],
  "source_files": [
    "Frameworks/ThingFFmpegWrapper/ThingFFmpegWrapper.xcframework/**/*.h"
  ]
}