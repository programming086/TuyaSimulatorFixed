{
  "name": "TUNIRecordingManager",
  "version": "1.1.3",
  "summary": "A short description of TUNIRecordingManager.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "1.1.3"
  },
  "platforms": {
    "ios": "10.0"
  },
  "resource_bundles": {
    "TUNIRecordingManager": [
      "ios/TUNIRecordingManager/Assets/*",
      "js/dist/index.js"
    ]
  },
  "frameworks": "AVFoundation",
  "dependencies": {
    "TUNIAPIManagerKit": [],
    "YYModel": [],
    "EZAudio": []
  },
  "pod_target_xcconfig": {
    "THING_PRIVACY_USAGE_DESCRIPTION": "NSMicrophoneUsageDescription",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "vendored_frameworks": [
    "Frameworks/TUNIRecordingManager/TUNIRecordingManager.xcframework"
  ],
  "cocoapods_version": ">= 1.10"
}