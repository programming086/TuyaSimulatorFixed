{
  "name": "TencentOpen",
  "version": "3.5.21",
  "summary": "The Official iOS SDK of Tencent Open API.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "3.5.21"
  },
  "platforms": {
    "ios": "9.0"
  },
  "static_framework": true,
  "vendored_frameworks": [
    "Frameworks/TencentOpen/TencentOpen.xcframework"
  ],
  "pod_target_xcconfig": {
    "FRAMEWORK_SEARCH_PATHS": "$(inherited)",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "libraries": [
    "iconv",
    "z",
    "c++",
    "sqlite3"
  ],
  "frameworks": [
    "Security",
    "SystemConfiguration",
    "CoreGraphics",
    "CoreTelephony",
    "WebKit"
  ],
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "cocoapods_version": ">= 1.10"
}