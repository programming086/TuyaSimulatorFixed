{
  "name": "ThingAudioProcessSDK",
  "version": "1.1.3",
  "summary": "ThingAudioProcessSDK framework.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "1.1.3"
  },
  "platforms": {
    "ios": "11.0"
  },
  "exclude_files": [
    "ThingAudioProcessSDK/**/Android/**/*.*",
    "ThingAudioProcessSDK/include/**/*.*",
    "ThingAudioProcessSDK/include/rapidjson/msinttypes/*.*"
  ],
  "dependencies": {
    "ThingAvLoggerSDK": [],
    "ThingTensorFlowLiteC": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/avlogger $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include",
    "ENABLE_BITCODE": "NO",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "vendored_frameworks": [
    "Frameworks/ThingAudioProcessSDK/ThingAudioProcessSDK.xcframework"
  ],
  "source_files": [
    "Frameworks/ThingAudioProcessSDK/ThingAudioProcessSDK.xcframework/**/*.h"
  ]
}