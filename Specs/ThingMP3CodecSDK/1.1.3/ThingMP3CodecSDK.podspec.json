{
  "name": "ThingMP3CodecSDK",
  "version": "1.1.3",
  "summary": "ThingMP3CodecSDK framework.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "1.1.3"
  },
  "platforms": {
    "ios": "11.0"
  },
  "exclude_files": "ThingMP3CodecSDK/**/Android/**/*.*",
  "ios": {},
  "dependencies": {
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingMP3CodecSDK/Utils ",
    "ENABLE_BITCODE": "NO",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "vendored_frameworks": [
    "Frameworks/ThingMP3CodecSDK/ThingMP3CodecSDK.xcframework"
  ],
  "source_files": [
    "Frameworks/ThingMP3CodecSDK/ThingMP3CodecSDK.xcframework/**/*.h"
  ]
}