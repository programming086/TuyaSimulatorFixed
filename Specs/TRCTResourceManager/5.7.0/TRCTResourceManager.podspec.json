{
  "name": "TRCTResourceManager",
  "version": "5.7.0",
  "summary": "A short description of TRCTResourceManager.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "git": "https://github.com/programming086/TuyaSimulatorFixed.git",
    "tag": "5.7.0"
  },
  "platforms": {
    "ios": "9.0"
  },
  "ios": {
    "resource_bundles": {
      "ui_style_config": "resource/ui_style_config/*.json",
      "iconfont": [
        "resource/iconfont/*.json",
        "resource/iconfont/*.ttf"
      ]
    }
  },
  "resources": [
    "resource/*.json"
  ],
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "vendored_frameworks": [
    "Frameworks/TRCTResourceManager/TRCTResourceManager.xcframework"
  ],
  "cocoapods_version": ">= 1.10"
}